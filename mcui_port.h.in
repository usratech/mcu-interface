#pragma once

#include <stdint.h>

#include "${MCUI_MUTEX_FUNC_HEADER}"

#ifdef __cplusplus
extern "C" {
#endif

/**************************************************************************************************
 *                                          Definitions
 *************************************************************************************************/

#define MCUI_MUTEX_ACQUIRED_RET_CODE ${EXT_MUTEX_ACQUIRED_RET_CODE_VALUE}

typedef void *mcui_mutex_t;

#define MCUI_MUTEX_CREATE       ${EXT_MUTEX_CREATE_FUNC}
#define MCUI_MUTEX_ACQUIRE      ${EXT_MUTEX_ACQUIRE_FUNC}
#define MCUI_MUTEX_ACQUIRE_WAIT ${EXT_MUTEX_ACQUIRE_WAIT}
#define MCUI_MUTEX_RELEASE      ${EXT_MUTEX_RELEASE_FUNC}

/**
 * 
 * @brief Mutex usage example below
 * 
 * mcui_mutex_t mutex = MCUI_MUTEX_CREATE();
 * 
 * if (mutex == NULL) {
 *     return NO_MEM;
 * }
 * 
 * if (MCU_MUTEX_ACQUIRED_RET_CODE != MCUI_MUTEX_ACQUIRE(mutex)) {
 *     return BUSY;
 * }
 * 
 * or
 * 
 * if (MCU_MUTEX_ACQUIRED_RET_CODE != MCUI_MUTEX_ACQUIRE_WAIT(mutex, 100)) {
 *     return BUSY;
 * }
 * 
 * do something with the resource now 
 * 
 * MCU_MUTEX_RELEASE(mutex);
 */

#ifdef __cplusplus
}
#endif
